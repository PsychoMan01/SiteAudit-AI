# SiteAudit configuration. Copy to .env and adjust. Never commit .env.

# development | test | production
APP_ENV=development
# Public base URL. Must be https:// in production (enables Secure cookies and HSTS).
APP_URL=http://localhost:8000
# Empty = SQLite in DATA_DIR. Production example: postgresql+psycopg://siteaudit:PASSWORD@localhost/siteaudit
DATABASE_URL=
# Required in production, at least 32 random characters: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# Where SQLite, backups and the dev e-mail outbox live.
DATA_DIR=var
LOG_LEVEL=INFO
# text | json (json is the production default)
LOG_FORMAT=

# Worker: run audits inside the web process (development only). In production run `siteaudit worker`.
WORKER_EMBEDDED=true
WORKER_CONCURRENCY=2

# Crawler limits
CRAWL_REQUEST_TIMEOUT=10
CRAWL_AUDIT_TIMEOUT=300
CRAWL_DELAY=0.5
CRAWL_MAX_RESPONSE_BYTES=5242880
# Never enable in production (refused at start-up). Only for local testing against private hosts.
ALLOW_PRIVATE_TARGETS=false

# Optional AI summaries: none | ollama | openai (any OpenAI-compatible endpoint)
AI_PROVIDER=none
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
AI_TIMEOUT=60

# Optional SMTP. Without SMTP_HOST, e-mails are written to DATA_DIR/outbox/.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=SiteAudit <no-reply@example.com>
SMTP_STARTTLS=true

# Shown on pricing/legal pages when set.
CONTACT_EMAIL=
# Comma-separated reverse-proxy addresses/CIDRs whose X-Forwarded-For is trusted.
TRUSTED_PROXIES=127.0.0.1
